# LLM API (选题评分 + 文章生成)
# 方式一：直接用 Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# 方式二：用智谱 GLM Coding Plan（Anthropic 兼容 API，更便宜）
# ANTHROPIC_API_KEY=你的智谱API密钥
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# LLM_MODEL=glm-4.7
#
# 不设 ANTHROPIC_BASE_URL 则默认走 Anthropic 官方 API
# 不设 LLM_MODEL 则默认用 claude-sonnet-4-20250514
#
# 方式三：使用本机 Codex CLI 做 draft:article 文本推理
# LLM_PROVIDER=codex
# CODEX_BIN=codex
# CODEX_MODEL=gpt-5.1-codex
# CODEX_PROFILE=
# CODEX_TIMEOUT_MS=300000

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# LLM_MODEL=glm-4.7
# LLM_PROVIDER=codex
# CODEX_MODEL=gpt-5.1-codex

# 每日批量生成
DAILY_DRAFT_COUNT=7
DAILY_DRAFT_MIN=6
DAILY_DRAFT_MAX=10
DAILY_SOURCES_LIMIT=160

# OpenAI (draft:article 生成微信公众号封面图)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1808x768
OPENAI_IMAGE_QUALITY=medium

# Google AI (Gemini / Nano Banana for cover images)
GOOGLE_AI_API_KEY=

# 微信公众号 (publish.js 使用，MVP 阶段可暂不配置)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=PromptIO
# 公众号发布需要封面素材 media_id。可先手动上传封面到素材库后填这个值，
# 或使用 npm run publish -- <draft> --wechat-cover <cover.png> 自动上传。
WECHAT_THUMB_MEDIA_ID=
WECHAT_COVER_MEDIA_TYPE=thumb
WECHAT_TIMEOUT_MS=30000

# 小红书
# 小红书普通创作者发布没有稳定公开 API。publish.js 当前生成创作中心发布包，
# 再到 https://creator.xiaohongshu.com/ 手动上传。
XHS_PUBLISH_MODE=package
